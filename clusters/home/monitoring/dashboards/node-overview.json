          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info{job=\"node-exporter\",nodename=~\"$node\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(node_uname_info{job=\"node-exporter\",nodename=~\"$node\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "hide": 2,
        "options": [],
        "current": {
          "text": "",
          "value": ""
        },
        "multi": false,
        "includeAll": false
      },
      {
