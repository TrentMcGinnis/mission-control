        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kube_pod_info{node=~\"$node\"}, namespace)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kube_pod_info{node=~\"$node\"}, namespace)",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
